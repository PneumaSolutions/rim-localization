msgstr "%{screen_reader_name} está em execução no computador remoto."

msgid "%{screen_reader_name} %{version} is running on the remote machine."
msgstr "%{screen_reader_name} %{version} está em execução no computador remoto."

msgid "Starting remote accessibility."
msgstr "Início da acessibilidade remota."

msgid "Comment on This Session"
msgstr "Comente sobre esta sessão"

msgid ""
"You may optionally write a comment on the session that just ended. This "
"comment will appear on your RIM Dashboard."
msgstr ""
"Opcionalmente, você pode escrever um comentário sobre a sessão que acabou"
" de terminar. Esse comentário será exibido em seu RIM Dashboard."

msgid "Comment:"
msgstr "Como posso ajudar?"

