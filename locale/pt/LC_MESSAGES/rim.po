msgid ""
"%{controller_name} wants to remotely control this computer. Press "
"Option+Shift+Y to accept this request or Option+Shift+N to reject it."
msgstr ""
"%{controller_name} deseja controlar remotamente este computador. "
"Pressione Option+Shift+Y para aceitar essa solicitação ou Option+Shift+N "
"para rejeitá-la."

msgid ""
"%{controller_name} wants to remotely control this computer. Press "
"Windows+Shift+Y to accept this request or Windows+Shift+N to reject it."
msgstr ""
"%{controller_name} deseja controlar remotamente este computador. "
"Pressione Windows+Shift+Y para aceitar essa solicitação ou "
"Windows+Shift+N para rejeitá-la."

msgid ""
"You have accepted %{controller_name}'s request to remotely control this "
"computer."
msgstr ""
"Você aceitou a solicitação de %{controller_name} para controlar "
"remotamente este computador."

msgid ""
"You have rejected %{controller_name}'s request to remotely control this "
"computer."
msgstr ""
"Você rejeitou a solicitação de %{controller_name} para controlar "
"remotamente este computador."

msgid "Remote Incident Manager %{version}: waiting for approved connections"
msgstr "Remote Incident Manager %{version}: aguardando conexões aprovadas"

msgid "&Revoke Remote Access to This Computer"
msgstr "&Revogar o acesso remoto a este computador"

msgid "Remote Incident Manager %{version}: Receive Remote Help"
msgstr "Gerenciador de Incidentes Remotos %{version}: Receber ajuda remota"

msgid ""
"%{controller_name} is requesting permission to access this computer "
"without requiring you to start a remote session. You will be prompted for"
" permission to access your computer each time. Do you want to allow this?"
msgstr ""
"%{controller_name} está solicitando permissão para acessar este "
"computador sem exigir que você inicie uma sessão remota. Será solicitada "
"a sua permissão para acessar o computador todas as vezes. Deseja permitir"
" isso?"

msgid ""
"%{controller_name} is requesting permission to access this computer at "
"any time without requiring you to start a remote session, and without "
"being prompted for permission each time. Do you want to allow this?"
msgstr ""
"%{controller_name} está solicitando permissão para acessar este "
"computador a qualquer momento, sem que seja necessário iniciar uma sessão"
" remota e sem que a permissão seja solicitada a cada vez. Você deseja "
"permitir isso?"

msgid ""
"Do you want to have a voice conversation with %{controller_name} during "
"this remote control session?"
msgstr ""
"Deseja ter uma conversa de voz com %{controller_name} durante esta sessão"
" de controle remoto?"

msgid ""
"Do you want to have a voice conversation with the person that is "
"currently remotely controlling this computer during this session?"
msgstr ""
"Deseja ter uma conversa de voz com a pessoa que está controlando "
"remotamente este computador durante esta sessão?"

