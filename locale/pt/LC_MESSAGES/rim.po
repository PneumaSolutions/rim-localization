msgstr "Usar o Incident Pass"

msgid "Use Day Pass"
msgstr "Use o Day Pass"

msgid "Use Other Incident Pass"
msgstr "Usar outra passagem de incidente"

msgid "Select another pass"
msgstr "Selecione outra passagem"

