msgstr ""
"Gestionnaire d'incidents à distance %{version} : Fournir une aide à "
"distance"

msgid "A shortcut called \"%{target_name}\" has been added to your desktop."
msgstr "Un raccourci appelé \"%{target_name}\" a été ajouté à votre bureau."

msgid "Remote Incident Manager %{version}"
msgstr "Gestionnaire d'incidents à distance %{version}"

msgid "E&xit"
msgstr "&Quitter"

msgid ""
"Do you want to revoke %{controller_name}'s permission to start unattended"
" remote sessions on this computer?"
msgstr ""
"Voulez-vous révoquer l'autorisation de %{controller_name} à démarrer des "
"sessions distantes sans surveillance sur cet ordinateur ?"

msgid "%{controller_name} is no longer allowed to remotely access this computer."
msgstr ""
"%{controller_name} n'est plus autorisé à accéder à distance à cet "
"ordinateur."

msgid ""
"%{controller_name} wants to remotely control this computer. Press "
"Option+Shift+Y to accept this request or Option+Shift+N to reject it."
msgstr ""
"%{controller_name} veut contrôler cet ordinateur à distance. Appuyez sur "
"Option+Shift+Y pour accepter cette demande ou sur Option+Shift+N pour la "
"rejeter."

msgid ""
"%{controller_name} wants to remotely control this computer. Press "
"Windows+Shift+Y to accept this request or Windows+Shift+N to reject it."
msgstr ""
"%{controller_name} veut contrôler cet ordinateur à distance. Appuyez sur "
"Windows+Shift+Y pour accepter cette demande ou sur Windows+Shift+N pour "
"la rejeter."

msgid ""
"You have accepted %{controller_name}'s request to remotely control this "
"computer."
msgstr ""
"Vous avez accepté %{controller_name} la demande de contrôle à distance de"
" cet ordinateur."

msgid ""
"You have rejected %{controller_name}'s request to remotely control this "
"computer."
msgstr ""
"Vous avez rejeté %{controller_name} de prendre le contrôle à distance de "
"cet ordinateur."

msgid "Remote Incident Manager %{version}: waiting for approved connections"
msgstr ""
"Gestionnaire d'incidents à distance %{version} : attente de connexions "
"approuvées"

msgid "&Revoke Remote Access to This Computer"
msgstr "&Révoquer l'accès à distance à cet ordinateur"

msgid "Remote Incident Manager %{version}: Receive Remote Help"
msgstr ""
"Gestionnaire d'incidents à distance %{version} : Recevoir de l'aide à "
"distance"

msgid ""
"%{controller_name} is requesting permission to access this computer "
"without requiring you to start a remote session. You will be prompted for"
" permission to access your computer each time. Do you want to allow this?"
msgstr ""
"%{controller_name} demande l'autorisation d'accéder à cet ordinateur sans"
" vous demander de démarrer une session à distance. Il vous demandera à "
"chaque fois l'autorisation d'accéder à votre ordinateur. Souhaitez-vous "
"l'autoriser ?"

msgid ""
"%{controller_name} is requesting permission to access this computer at "
"any time without requiring you to start a remote session, and without "
"being prompted for permission each time. Do you want to allow this?"
msgstr ""
"%{controller_name} demande l'autorisation d'accéder à cet ordinateur à "
"tout moment sans que vous ayez à démarrer une session à distance et sans "
"que l'autorisation vous soit demandée à chaque fois. Souhaitez-vous "
"l'autoriser ?"

msgid ""
"Do you want to have a voice conversation with %{controller_name} during "
"this remote control session?"
msgstr ""
"Souhaitez-vous avoir une conversation vocale avec %{controller_name} "
"pendant cette session de contrôle à distance ?"

msgid ""
"Do you want to have a voice conversation with the person that is "
"currently remotely controlling this computer during this session?"
msgstr ""
"Souhaitez-vous avoir une conversation vocale avec la personne qui "
"contrôle actuellement cet ordinateur à distance pendant cette session ?"

msgid "The remote user has denied your request for a voice conversation."
msgstr "L'utilisateur distant a refusé votre demande de conversation vocale."

