msgstr "1つのファイルをターゲットマシンに転送しています。"

msgid "Try again"
msgstr "もう一度試してみてください"

msgid "Two-Finger Double-Tap"
msgstr "2本指でのダブルタップ"

msgid "Type text to send"
msgstr "送信したいテキストを入力してください"

msgid "Type text to send to remote"
msgstr "リモートに送信するテキストを入力してください"

msgid "Unattended access is not available for this account."
msgstr "このアカウントでは、無人アクセスは利用できません。"

