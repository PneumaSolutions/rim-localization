msgstr "%{controller_name} ya no puede acceder remotamente a este ordenador."

msgid ""
"%{controller_name} wants to remotely control this computer. Press "
"Option+Shift+Y to accept this request or Option+Shift+N to reject it."
msgstr ""
"%{controller_name} quiere controlar remotamente este ordenador. Pulse "
"Opción+Mayús+Y para aceptar esta solicitud u Opción+Mayús+N para "
"rechazarla."

msgid ""
"%{controller_name} wants to remotely control this computer. Press "
"Windows+Shift+Y to accept this request or Windows+Shift+N to reject it."
msgstr ""
"%{controller_name} desea controlar remotamente este ordenador. Pulse "
"Windows+Mayús+Y para aceptar esta solicitud o Windows+Mayús+N para "
"rechazarla."

msgid ""
"You have accepted %{controller_name}'s request to remotely control this "
"computer."
msgstr "Ha aceptado %{controller_name} para controlar remotamente este ordenador."

msgid ""
"You have rejected %{controller_name}'s request to remotely control this "
"computer."
msgstr "Ha rechazado %{controller_name} para controlar remotamente este ordenador."

msgid "Remote Incident Manager %{version}: waiting for approved connections"
msgstr "Gestor remoto de incidencias %{version}: esperando conexiones aprobadas"

msgid "&Revoke Remote Access to This Computer"
msgstr "&Revocar el acceso remoto a este ordenador"

msgid "Remote Incident Manager %{version}: Receive Remote Help"
msgstr "Gestor remoto de incidencias %{version}: Recibir Ayuda Remota"

msgid ""
"%{controller_name} is requesting permission to access this computer "
"without requiring you to start a remote session. You will be prompted for"
" permission to access your computer each time. Do you want to allow this?"
msgstr ""
"%{controller_name} está solicitando permiso para acceder a este ordenador"
" sin necesidad de iniciar una sesión remota. Se le pedirá permiso para "
"acceder a su ordenador cada vez. ¿Desea permitirlo?"

msgid ""
"%{controller_name} is requesting permission to access this computer at "
"any time without requiring you to start a remote session, and without "
"being prompted for permission each time. Do you want to allow this?"
msgstr ""
"%{controller_name} está solicitando permiso para acceder a este ordenador"
" en cualquier momento sin necesidad de iniciar una sesión remota y sin "
"que se le pida permiso cada vez. ¿Desea permitirlo?"

msgid ""
"Do you want to have a voice conversation with %{controller_name} during "
"this remote control session?"
msgstr ""
"¿Desea mantener una conversación de voz con %{controller_name} durante "
"esta sesión de control remoto?"

msgid ""
"Do you want to have a voice conversation with the person that is "
"currently remotely controlling this computer during this session?"
msgstr ""
"¿Desea mantener una conversación de voz con la persona que actualmente "
"controla remotamente este ordenador durante esta sesión?"

