msgstr "Gestor Remoto de Incidencias: Recibir ayuda a distancia"

msgid "Receive Remote Help"
msgstr "Recibir ayuda a distancia"

msgid "Please enter the keyword you received from the person helping you."
msgstr ""
"Por favor, introduzca la palabra clave que recibió de la persona que le "
"ayudó."

msgid "Connect"
msgstr "Conectar"

msgid "Provide help instead"
msgstr "En su lugar, proporcione ayuda"

msgid "Add this machine to your RIM account"
msgstr "Añade esta máquina a tu cuenta RIM"

msgid ""
"You must enter a keyword before you can start the remote session. Please "
"enter the keyword that was provided by the person that is helping you."
msgstr ""
"Debe introducir una palabra clave antes de poder iniciar la sesión "
"remota. Introduzca la palabra clave que le proporcionó la persona que le "
"está ayudando."

msgid "Language"
msgstr "Idioma"

msgid "English"
msgstr "Inglés"

msgid "German"
msgstr "Alemán"

msgid "Spanish"
msgstr "Español"

msgid "French"
msgstr "Francés"

